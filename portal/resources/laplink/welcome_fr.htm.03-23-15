	<table width="95%" align="center" border="0" cellspacing="0" cellpadding="0" ID="Table3">
		<TR>
			<td class="toolbar_heading_black" background="x-res/GRADIENT_1.GIF" colspan="2">Qu&rsquo;est-ce que ce 
