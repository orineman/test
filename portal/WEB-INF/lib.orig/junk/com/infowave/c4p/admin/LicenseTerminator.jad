        if(regCodes == null || regCodes.size() == 0)
        {
            System.out.println("Unknown (or already revoked) reg code: " + m_code);
            return false;
        }
        for(Iterator it = regCodes.iterator(); it.hasNext(); System.out.println("revoked registration code: " + m_code))
        {
            License regCode = (License)it.next();
            if(!regCode.isRegCode())
            {
                System.out.println("License: " + m_code + " is not a registration code");
                return false;
            }
            if(!regCode.hasExpired() && regCode.getAccount() != null && regCode.getAccount().getDesktops() != null)
                removeLicenseFromDesktops(regCode.getAccount());
            regCode.setRevoked(true);
            licenseDAO.update(regCode);
        }

        return true;
    }

    private int getLicenseCodeSize()
