    private boolean revokeLicense()
        throws DataException, ServiceException
    {
        LicenseDAO licenseDAO = DAOFactory.getLicenseDAO();
        List licenses = licenseDAO.getByCode(m_code, m_reseller.getId());
        if(licenses == null || licenses.size() == 0)
        {
            System.out.println("Unknown license (or already revoked) code: " + m_code);
            return false;
        }
        if(licenses.size() > 1)
        {
            System.out.println("Error: more than one license with code: " + m_code);
            return false;
        }
        License license = (License)licenses.get(0);
        if(license.isRegCode())
        {
            System.out.println("License: " + m_code + " is a registration code");
            return false;
        }
        if(license.isRevoked())
        {
            System.out.println("License: " + m_code + " is already revoked");
            return true;
        }
        if(license.hasExpired())
        {
            license.setRevoked(true);
            licenseDAO.update(license);
            System.out.println("Revoked the expired license: " + m_code);
            return true;
        }
        if(license.getAccount() == null)
        {
            license.setRevoked(true);
            licenseDAO.update(license);
            System.out.println("Revoked the unused license: " + m_code);
            return true;
        }
        if(license.getAccount().getDesktops() == null)
        {
            license.setRevoked(true);
            licenseDAO.update(license);
            System.out.println("Revoked the unused license: " + m_code);
            return true;
        } else
        {
            removeLicenseFromDesktops(license.getAccount());
            license.setRevoked(true);
            licenseDAO.update(license);
            System.out.println("Revoked the license: " + m_code);
            return true;
        }
    }

    private boolean removeLicenseFromDesktops(Account account)
        throws DataException, ServiceException
    {
        LicenseManager licenseMgr = DelegateFactory.getLicenseManager();
        for(Iterator it = account.getDesktops().iterator(); it.hasNext();)
        {
            Desktop desktop = (Desktop)it.next();
            if(desktop.hasUsedLicenseCode(m_code))
            {
                List removedLicenses = licenseMgr.unlicense(desktop.getId());
                System.out.println("unlicensed desktop: " + desktop.getDid() + " user: " + account.getUsername());
                if(removedLicenses != null && removedLicenses.size() > 1)
                {
                    boolean first = true;
                    for(Iterator jt = removedLicenses.iterator(); jt.hasNext();)
                    {
                        LicenseDTO removed = (LicenseDTO)jt.next();
                        if(!removed.getCode().equals(m_code))
                        {
                            licenseMgr.setLicenseCode(account.getId(), desktop.getId(), removed.getCode(), !first);
                            first = false;
                            System.out.println("Added back license: " + removed.getCode() + " to desktop: " + desktop.getDid() + " user: " + account.getUsername());
                        }
                    }

                }
            }
        }

        return true;
    }

    private boolean revokeRegCode()
