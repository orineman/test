            {
                m_log.warn("unlicense - no dektop with id: " + desktopId);
                PortalError error = new PortalError(ErrorCode.INVALID_ID);
                throw new ServiceException(error, desktopId);
            }
            removedLicenses = removeAllLicenses(desktop, desktop.getLicense(), desktop.getAccount(), desktop.getAccount().getReseller());
            licenseDAO.unlicenseDesktop(removedLicenses, desktop);
        }
        catch(DataException e)
        {
            PortalError error = new PortalError(ErrorCode.SYSTEM_ERROR);
            throw new ServiceException(error, e);
        }
        List freedUp = new ArrayList(3);
        if(removedLicenses != null)
        {
            com.infowave.c4p.service.dto.LicenseDTO dto;
            for(Iterator it = removedLicenses.iterator(); it.hasNext(); freedUp.add(dto))
            {
                License l = (License)it.next();
                dto = LicenseAssembler.createLicenseDTO(l);
            }

        }
        return freedUp;
    }

    public List purgeExpiredLicenseFromHistory(Desktop desktop, Account account)
        throws DataException
    {
        List removed = new ArrayList(2);
        LicenseDAO licenseDAO = DAOFactory.getLicenseDAO();
        String history[] = desktop.getLicenseCodesInHistory();
        for(int i = 0; i < history.length; i++)
        {
            List licenses = licenseDAO.getByCodeAndUserId(history[i], account.getReseller().getId(), account.getId());
            if(licenses.size() == 0)
            {
                String msg = "purgeExpiredLicenseFromHistory - data inconsistency: a license is present in  the history but we can't find a license with that code for that user desktop: " + desktop.getDid() + " code: " + history[i] + " user: " + account.getUsername() + " (" + account.getId() + ") reseller: " + account.getReseller().getId();
                m_log.error(msg);
                throw new DataException(msg);
            }
            if(licenses.size() > 1)
            {
                String msg = "purgeExpiredLicenseFromHistory - data inconsistency: a license is present in  the history and we have " + licenses.size() + " licenses with " + " that code for that user" + " desktop: " + desktop.getDid() + " code: " + history[i] + " user: " + account.getUsername() + " (" + account.getId() + ") reseller: " + account.getReseller().getId();
                m_log.error(msg);
                throw new DataException(msg);
            }
            License license = (License)licenses.get(0);
            if(license.hasExpired())
            {
                m_log.debug("purgeExpiredLicenseFromHistory - purging: " + license);
                desktop.removeLicenseFromHistory(license);
                removed.add(license);
            }
        }

        return removed;
    }

    private List removeAllLicenses(Desktop desktop, License lastLicense, Account account, Reseller reseller)
        throws DataException
    {
        List removed = new ArrayList(2);
        LicenseDAO licenseDAO = DAOFactory.getLicenseDAO();
        String history[] = desktop.getLicenseCodesInHistory();
        for(int i = 0; i < history.length; i++)
        {
            License license;
            if(lastLicense != null && lastLicense.getCode().equalsIgnoreCase(history[i]))
            {
                license = lastLicense;
            } else
            {
                List licenses = licenseDAO.getByCodeAndUserId(history[i], account.getReseller().getId(), account.getId());
                if(licenses.size() == 0)
                {
                    String msg = "removeAllLicenses - data inconsistency: a license is present in  the history but we can't find a license with that code for that user desktop: " + desktop.getDid() + " code: " + history[i] + " user: " + account.getUsername() + " (" + account.getId() + ") reseller: " + account.getReseller().getId();
                    m_log.error(msg);
                    throw new DataException(msg);
                }
                if(licenses.size() > 1)
                {
                    String msg = "removeAllLicenses - data inconsistency: a license is present in  the history and we have " + licenses.size() + " licenses with " + " that code for that user" + " desktop: " + desktop.getDid() + " code: " + history[i] + " user: " + account.getUsername() + " (" + account.getId() + ") reseller: " + account.getReseller().getId();
                    m_log.error(msg);
                    throw new DataException(msg);
                }
                license = (License)licenses.get(0);
            }
            m_log.debug("removeAllLicenses - found license " + license);
            if(!license.hasExpired())
            {
                removed.add(license);
                license.decrementNumUse();
                m_log.debug("removeAllLicenses - decreasing numUses for license: " + license.getCode());
                if(license.getNumUses() == 0 && license.isFixedTerm())
                {
                    int remainingDays = license.getRemainingDays();
                    m_log.debug("removeAllLicenses - resetting the duration for license: " + license.getCode() + " remaining days: " + remainingDays);
                    license.setDuration(remainingDays);
                    license.setFirstUseDate(null);
                }
            }
        }

        desktop.setLicenseHistory(null);
        desktop.setLicense(null);
        desktop.setLicenseSerialNumber(null);
        desktop.setExpiryDate(null);
        Date creationDate = desktop.getCreationDate();
        desktop.setExpiryDate(reseller.getDemoExpiryDate(creationDate));
        m_log.debug("removeAllLicenses - After removing all licenses,  the expiry date for desktop " + desktop.getDid() + " is now: " + desktop.getExpiryDate());
        return removed;
    }

    public License findLicense(String code, Desktop desktop, Account account, Reseller reseller)
        throws ServiceException
    {
        License license;
        LicenseDAO licenseDAO;
        license = null;
        licenseDAO = DAOFactory.getLicenseDAO();
        if(!desktop.hasUsedLicenseCode(code))
            break MISSING_BLOCK_LABEL_57;
        m_log.debug("Cannot use - license " + code + " has already been used by desktop " + desktop.getDid());
        return null;
        List usedLicenses = licenseDAO.getByCodeAndUserId(code, reseller.getId(), account.getId());
        for(Iterator it = usedLicenses.iterator(); it.hasNext();)
        {
            License l = (License)it.next();
            if(l.getNumUses() < l.getMaxUses() && !desktop.hasUsedLicenseCode(code) && !l.hasExpired())
            {
                license = l;
                break;
            }
            if(l.getNumUses() >= l.getMaxUses())
                m_log.debug("Cannot use - license " + l.getCode() + "[" + l.getId() + "] has exceeded the nb of uses (" + l.getNumUses() + " uses - max = " + l.getMaxUses() + ")");
            else
            if(desktop.hasUsedLicenseCode(code))
                m_log.debug("Cannot use - license " + l.getCode() + "[" + l.getId() + "] has already been used by desktop " + desktop.getDid());
            else
            if(l.hasExpired())
                m_log.debug("Cannot use - license " + l.getCode() + "[" + l.getId() + "] has expired " + l);
        }

        if(license != null)
            m_log.debug("Found a previoulsy used license with " + code + " code " + " for user " + account.getUsername());
        else
            m_log.debug("Found no previoulsy used license with " + code + " code " + " for user " + account.getUsername());
        if(license == null)
        {
            List unusedLicenses = licenseDAO.getUnusedByCode(code, reseller.getId());
            if(!unusedLicenses.isEmpty())
                license = (License)unusedLicenses.get(0);
            if(license != null)
                m_log.debug("Found an unused license with " + code + " code " + " for user " + account.getUsername());
            else
                m_log.debug("Found no unused license with " + code + " code " + " for user " + account.getUsername());
        }
        if(license != null && license.isFixedTerm() && !license.isRegCode() && license.getMaxUses() != 1)
        {
            m_log.error("findLicense - The license we found is a fixed term, yet  its maxuses is > 1: " + license);
            license = null;
        }
        return license;
        DataException e;
        e;
        PortalError error = new PortalError(ErrorCode.SYSTEM_ERROR);
        throw new ServiceException(error, e);
    }

