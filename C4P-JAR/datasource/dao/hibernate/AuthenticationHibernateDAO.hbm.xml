<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD//EN"
                                   "http://localhost:1234/dtds/hibernate-mapping-2.0.dtd">

<hibernate-mapping>

    <class name="com.infowave.c4p.model.Authentication" table="authentication">

       <id name="id" type="string" unsaved-value="null" >
            <column name="id" length="32" not-null="true"/>
            <generator class="uuid.hex"/>
        </id>

        <property name="username">
           <column name="username" unique="true"  sql-type="varchar(20)"/>
        </property>

        <property name="password">
            <column name="password" not-null="true" sql-type="varchar(20)"/>
        </property>
        <property name="authType">
            <column name="authtype" not-null="true"  sql-type="varchar(250)"/>
        </property>

        <property name="rolename">
          <column name="rolename"  not-null="true"  sql-type="varchar(10)"/>
        </property>
       
      <!--         -->
      <!-- Account -->
      <!--         -->
      <many-to-one
        name="account"
        column="accountId"
        not-null="false"/>
    </class>
  <!--                                                        -->
  <!--                          Queries                       -->
  <!--                                                        -->

  <query name="Authentication.by.username">
    <![CDATA[
     from Authentication as authentication where authentication.username= :username
     ]]>
     </query>
</hibernate-mapping>