<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

  <class name="com.infowave.c4p.model.Desktop" table="desktop" lazy="false">

    <id name="id" type="string" unsaved-value="null" >
      <column name="id" length="32" not-null="true"/>
      <generator class="uuid.hex"/>
    </id>
    <property name="did">
      <column name="did" sql-type="varchar(128)" unique="true" not-null="true"/>
    </property>
    <property name="name">
      <column name="name" sql-type="varchar(20)"/>
    </property>
    <property name="owner">
      <column name="owner" sql-type="varchar(20)"/>
    </property>
    <property name="licenseSerialNumber">
      <column name="licenseSerialNumber" sql-type="varchar(250)"/>
    </property>
    <property name="expiryDate"/>
    <property name="creationDate"/>
    <property name="visible"/>
    <property name="licenseHistory">
      <column name="licenseHistory" sql-type="text"/>
    </property>
    <property name="registrationCode">
      <column name="registrationCode" sql-type="varchar(100)"/>
    </property>
    <property name="softwareVersion">
      <column name="softwareVersion" sql-type="varchar(10)"/>
    </property>
	  <property name="hostPublicKey">
		<column name="hostPublicKey" sql-type="text"/>
	  </property>
	  <property name="serverPrivateKey">
		<column name="serverPrivateKey" sql-type="text"/>
	  </property>
      <property name="ssid">
          <column name="ssid" sql-type="varchar(32)"/>
      </property>
    <!--         -->
    <!-- Account -->
    <!--         -->
    <!-- the accountId column can be null because we can create
         a desktop before an account -->
    <many-to-one name="account" column="accountId" not-null="false"/>
    

    <!--                  -->
    <!-- Foreign Accounts -->
    <!--                  -->

    <set name="foreignAccounts" table="desktopaccess"  lazy="false">
        <key column="desktopId"/>
        <many-to-many class="com.infowave.c4p.model.Account" column="accountId"/>
      </set>

    <!--         -->
    <!-- License -->
    <!--         -->

    <many-to-one  name="license" column="licenseId"  />

  </class>


  <!--                                                        -->
  <!--                          Queries                       -->
  <!--                                                        -->

  <query name="Desktop.by.did">
    <![CDATA[
     from Desktop as desktop where desktop.did= :did
     ]]>
     </query>

  <query name="Desktop.by.id">
    <![CDATA[
     from Desktop as desktop where desktop.id= :id
     ]]>
     </query>

  <query name="Desktop.by.owner">
    <![CDATA[
     from Desktop as desktop where desktop.owner= :owner
     ]]>
     </query>


  <query name="Desktop.like.desktopname">
    <![CDATA[
     from Desktop as desktop where desktop.name like :name
     ]]>
     </query>

  <query name="Desktop.like.accountname">
    <![CDATA[
     from Desktop as desktop where desktop.owner like :owner
     ]]>
     </query>

  <query name="Desktop.like.license">
    <![CDATA[
     from Desktop as desktop where desktop.licenseSerialNumber like :licenseSerialNumber
     ]]>
     </query>

  <query name="Desktop.like.expirydate">
    <![CDATA[
     from Desktop as desktop where desktop.expiryDate like :expiryDate
     ]]>
     </query>

  <query name="Count.desktops.like.desktopname">
    <![CDATA[
     select count(desktop) from Desktop as desktop where desktop.name like :name
     ]]>
     </query>

  <query name="Count.desktops.like.accountname">
    <![CDATA[
     select count(desktop) from Desktop as desktop where desktop.owner like :owner
     ]]>
     </query>

  <query name="Count.desktops.like.license">
    <![CDATA[
     select count(desktop) from Desktop as desktop where desktop.licenseSerialNumber like :licenseSerialNumber
     ]]>
     </query>

  <query name="Count.desktops.like.expirydate">
    <![CDATA[
     select count(desktop) from Desktop as desktop where desktop.expiryDate like :expiryDate
     ]]>
     </query>






</hibernate-mapping>
