<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE web-app
  PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
  "http://java.sun.com/dtd/web-app_2_3.dtd">


<web-app>
	<display-name>C4P Application</display-name>
<filter>
    <filter-name>FileUploadFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.UploadFilter</filter-class>
</filter>
<filter>
    <filter-name>DeviceIconFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.DeviceIconFilter</filter-class>
</filter>
<filter>
    <filter-name>DownloadFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.DownloadFilter</filter-class>
</filter>
<filter>
    <filter-name>PassThruFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.PassThruFilter</filter-class>
</filter>
<filter>
    <filter-name>ResourceFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.ResourceFilter</filter-class>
</filter>
<filter>
    <filter-name>SessionConfigurationFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.SessionConfigurationFilter</filter-class>
</filter>
<filter>
    <filter-name>ApplicationFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.ApplicationFilter</filter-class>
</filter>
<filter>
    <filter-name>RemoteControlFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.RemoteControlFilter</filter-class>
</filter>



  <!-- Important: the DeviceIcon and Resource filter must be placed before the
     ICMRedirector filter
-->

<filter-mapping>
    <filter-name>DeviceIconFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>
<filter-mapping>
    <filter-name>ResourceFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>
<filter-mapping>
    <filter-name>DownloadFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>
<filter-mapping>
    <filter-name>PassThruFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>


<filter-mapping>
    <filter-name>SessionConfigurationFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>

<filter-mapping>
    <filter-name>ApplicationFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>
<filter-mapping>
    <filter-name>RemoteControlFilter</filter-name>
    <url-pattern>/*</url-pattern>
</filter-mapping>



  <!-- Action Servlet Configuration -->
  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
    <init-param>
      <!-- note: can be a comma-separated list -->
      <param-name>config</param-name>
      <param-value>/WEB-INF/struts-config.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>LLG</servlet-name>
    <servlet-class>llcenter.LLGHandler</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>LLGReg</servlet-name>
    <servlet-class>llcenter.LLGRegister</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>


  <!-- Action Servlet Mapping -->
  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>LLG</servlet-name>
    <url-pattern>/xhtml/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>LLGReg</servlet-name>
    <url-pattern>/lf-xhtml-loudpc/_all/public/lle/*</url-pattern>
  </servlet-mapping>



  <!-- The Welcome File List -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Error pages -->

  <error-page>
    <error-code>500</error-code>
    <location>/showGeneralErrorPage.do</location>
  </error-page>

  <error-page>
    <error-code>404</error-code>
     <location>/showError404Page.do</location>
  </error-page>

  <!-- Application Tag Library Descriptor -->
  <taglib>
    <taglib-uri>/WEB-INF/tlds/app.tld</taglib-uri>
    <taglib-location>/WEB-INF/tlds/app.tld</taglib-location>
  </taglib>
  <!-- JSTL Tag Library Descriptor -->
  <taglib>
    <taglib-uri>/WEB-INF/tlds/c.tld</taglib-uri>
    <taglib-location>/WEB-INF/tlds/c.tld</taglib-location>
  </taglib>

  <!-- Struts Tag Library Descriptors -->
  <!-- todo remove as many struts tag lib as we can (ideally all) -->
  <taglib>
    <taglib-uri>/WEB-INF/tlds/struts-bean.tld</taglib-uri>
    <taglib-location>/WEB-INF/tlds/struts-bean.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/tlds/struts-html.tld</taglib-uri>
    <taglib-location>/WEB-INF/tlds/struts-html.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/tlds/struts-logic.tld</taglib-uri>
    <taglib-location>/WEB-INF/tlds/struts-logic.tld</taglib-location>
  </taglib>

  <!--                -->
  <!-- JNDi resources -->
  <!--                -->
  <resource-ref>
    <description>MySQL Datasource</description>
    <res-ref-name>jdbc/connectionPool</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <!--                   -->
  <!-- Security settings -->
  <!--                   -->
    <security-constraint>
      <display-name>LLG</display-name>
      <web-resource-collection>
        <url-pattern>/xhtml/*</url-pattern>
         <http-method>POST</http-method>
         <http-method>GET</http-method>
      </web-resource-collection>
    </security-constraint>
    <security-constraint>
      <display-name>Example Security Constraint</display-name>
      <web-resource-collection>
         <web-resource-name>Protected Area</web-resource-name>
	 <!-- Define the context-relative URL(s) to be protected -->
        <url-pattern>/protected/*</url-pattern>
        <!-- <url-pattern>/index.jsp</url-pattern> -->
	 <!-- If you list http methods, only those methods are protected -->
	 <http-method>DELETE</http-method>
         <http-method>GET</http-method>
         <http-method>POST</http-method>
	 <http-method>PUT</http-method>
      </web-resource-collection>
      <auth-constraint>
         <!-- Anyone with one of the listed roles may access this area -->
         <role-name>user</role-name>
	 <role-name>role1</role-name>
      </auth-constraint>
    </security-constraint>

    <!-- Default login configuration uses form-based authentication -->
    <login-config>
      <auth-method>FORM</auth-method>
       <!-- <auth-method>BASIC</auth-method>  -->
      <realm-name>Example Form-Based Authentication Area</realm-name>
      <form-login-config>
        <!--
        <form-login-page>/html/login.jsp</form-login-page>
        <form-error-page>/html/loginFailed.jsp</form-error-page>
        -->
        <form-login-page>/showLoginPage.do?action=protected</form-login-page>
        <form-error-page>/showLoginPage.do?action=error</form-error-page>
      </form-login-config>
    </login-config>

    <!-- Security roles referenced by this web application -->
    <security-role>
      <role-name>role1</role-name>
    </security-role>
    <security-role>
      <role-name>user</role-name>
    </security-role>

</web-app>
