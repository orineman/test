<web-app xmlns="http://java.sun.com/xml/ns/j2ee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee
http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd"
    version="2.4">

  <description>Remote Assist App</description>

  <filter>
    <filter-name>ResourceFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.ResourceFilter</filter-class>
  </filter>
  <filter>
    <filter-name>SessionConfigurationFilter</filter-name>
    <filter-class>com.infowave.c4p.web.filters.SessionConfigurationFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>ResourceFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>SessionConfigurationFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>



  <resource-ref>
    <description>MySQL Datasource</description>
    <res-ref-name>jdbc/connectionPool</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  <resource-ref>
      <description>DB Connection</description>
      <res-ref-name>jdbc/TestDB</res-ref-name>
      <res-type>javax.sql.DataSource</res-type>
      <res-auth>Container</res-auth>
  </resource-ref>

  <taglib>
    <taglib-uri>http://java.sun.com/jstl/core</taglib-uri>
    <taglib-location>/RAssist/WEB-INF/tld/c.tld</taglib-location>
  </taglib>
  <taglib>
    <taglib-uri>http://java.sun.com/jstl/sql</taglib-uri>
    <taglib-location>/RAssist/WEB-INF/tld/sql.tld</taglib-location>
  </taglib>
  <taglib>
    <taglib-uri>/WEB-INF/tld/log.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/taglibs-log.tld</taglib-location>
  </taglib>
  <taglib>
    <taglib-uri>/WEB-INF/tld/app.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/app.tld</taglib-location>
  </taglib>
  <!-- JSTL Tag Library Descriptor -->
  <taglib>
    <taglib-uri>/WEB-INF/tld/c.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/c.tld</taglib-location>
  </taglib>
  <taglib>
    <taglib-uri>/WEB-INF/tld/fmt.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/fmt.tld</taglib-location>
  </taglib>
  <taglib>
    <taglib-uri>/WEB-INF/tld/struts-bean.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/struts-bean.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/tld/struts-html.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/struts-html.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/tld/struts-logic.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/struts-logic.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/tld/struts-tiles.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/struts-tiles.tld</taglib-location>
  </taglib>


  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
    <init-param>
      <!-- note: can be a comma-separated list -->
      <param-name>config</param-name>
      <param-value>/WEB-INF/struts-config.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>VerifySession</servlet-name>
    <servlet-class>llremoteassist.VerifySession</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDGetDid</servlet-name>
    <servlet-class>llremoteassist.HDDid</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDReleaseDid</servlet-name>
    <servlet-class>llremoteassist.HDDid</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDLogin</servlet-name>
    <servlet-class>llremoteassist.HDSession</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDLogout</servlet-name>
    <servlet-class>llremoteassist.HDSession</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDLoginPoll</servlet-name>
    <servlet-class>llremoteassist.HDPoll</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDStatusPoll</servlet-name>
    <servlet-class>llremoteassist.HDPoll</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>HDTechInfo</servlet-name>
    <servlet-class>llremoteassist.HDTechnician</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>VerifySession</servlet-name>
    <url-pattern>/VerifySession</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDGetDid</servlet-name>
    <url-pattern>/HDGetDid</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDReleaseDid</servlet-name>
    <url-pattern>/HDEndDid</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDLogin</servlet-name>
    <url-pattern>/HDSession</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDLogout</servlet-name>
    <url-pattern>/HDFinal</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDLoginPoll</servlet-name>
    <url-pattern>/LStatus</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDStatusPoll</servlet-name>
    <url-pattern>/Status</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HDTechInfo</servlet-name>
    <url-pattern>/HDTechInfo</url-pattern>
  </servlet-mapping>

  <security-constraint>
    <display-name>Administrative Web Pages</display-name>
    <web-resource-collection>
       <web-resource-name>Admin Web Area</web-resource-name>
       <!-- Define the context-relative URL(s) to be protected -->
       <url-pattern>/protected/x-res/*</url-pattern>
       <!-- If you list http methods, only those methods are protected -->
       <http-method>GET</http-method>
    </web-resource-collection>
  </security-constraint>

  <security-constraint>
    <display-name>Administrative Web Pages</display-name>
    <web-resource-collection>
       <web-resource-name>Admin Web Area</web-resource-name>
       <!-- Define the context-relative URL(s) to be protected -->
       <url-pattern>/protected/*</url-pattern>
       <!-- If you list http methods, only those methods are protected -->
       <http-method>DELETE</http-method>
       <http-method>GET</http-method>
       <http-method>POST</http-method>
       <http-method>PUT</http-method>
    </web-resource-collection>
    <auth-constraint>
       <!-- Anyone with one of the listed roles may access this area -->
       <role-name>user</role-name>
       <role-name>role1</role-name>
    </auth-constraint>
  </security-constraint>



  <!-- Default login configuration uses form-based authentication -->
  <login-config>
    <auth-method>FORM</auth-method>
    <realm-name>Admin Web Pages Authentication Area</realm-name>
    <form-login-config>
      <form-login-page>/showLoginPage.do?action=protected</form-login-page>
      <form-error-page>/SetType.do?type=loginerror</form-error-page>
    </form-login-config>
  </login-config>

  <!-- Security roles referenced by this web application -->
  <security-role>
    <role-name>role1</role-name>
  </security-role>
  <security-role>
    <role-name>user</role-name>
  </security-role>


</web-app>
